{%- comment -%}
  Usage: {% render 'price', product: product, variant: variant, class: 'price--large' %}
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
  assign show_from = false
  if variant == blank and product.price_varies
    assign show_from = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %} {{ class }}" data-price>
  <span class="price__current">
    {%- if show_from -%}
      {%- assign min_price = product.price_min | money -%}
      {{ 'products.product.price_from' | t: price: min_price }}
    {%- else -%}
      {{ target.price | money }}
    {%- endif -%}
  </span>
  {%- if on_sale -%}
    <s class="price__compare">
      <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
      {{- target.compare_at_price | money -}}
    </s>
  {%- endif -%}
</div>
