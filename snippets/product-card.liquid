{%- comment -%}
  Product card in the girlogy shop style.
  Usage: {% render 'product-card', product: product, lazy: true %}

  Optional extras, set in Shopify admin:
  - Tagline: product metafield custom.tagline (single line text)
  - Badge: a product tag written as "badge:New", "badge:Best seller", "badge:Drop 02"...
{%- endcomment -%}
{%- liquid
  assign ratio_class = ''
  if settings.card_image_ratio == 'portrait'
    assign ratio_class = ' card__media--portrait'
  endif

  assign badge = ''
  for tag in product.tags
    if tag contains 'badge:'
      assign badge = tag | remove_first: 'badge:' | strip
      break
    endif
  endfor

  assign colour_option = null
  assign size_option = null
  for option in product.options_with_values
    assign option_key = option.name | downcase
    if option_key == 'color' or option_key == 'colour' or option_key == 'couleur'
      assign colour_option = option
    elsif option_key == 'size' or option_key == 'taille'
      assign size_option = option
    endif
  endfor

  assign first_image = product.featured_media
  assign second_image = product.media[1]
-%}

<article class="card">
  <a href="{{ product.url }}" class="card__media{{ ratio_class }}" tabindex="-1" aria-hidden="true">
    {%- if first_image -%}
      {%- if lazy -%}{%- assign loading = 'lazy' -%}{%- else -%}{%- assign loading = 'eager' -%}{%- endif -%}
      {%- assign card_alt = first_image.alt | default: product.title -%}
      {{
        first_image
        | image_url: width: 900
        | image_tag:
          loading: loading,
          sizes: '(min-width: 990px) 33vw, (min-width: 750px) 45vw, 50vw',
          widths: '360, 540, 720, 900',
          alt: card_alt
      }}
      {%- if settings.card_show_second_image and second_image -%}
        {{
          second_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            class: 'card__img-2',
            sizes: '(min-width: 990px) 33vw, (min-width: 750px) 45vw, 50vw',
            widths: '360, 540, 720, 900',
            alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      <span class="card__placeholder">{% render 'icon', name: 'girl' %}</span>
    {%- endif -%}

    <span class="card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--sold">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
      {%- elsif badge != '' -%}
        <span class="badge">{{ badge }}</span>
      {%- endif -%}
    </span>

    {%- if product.media.size > 1 -%}
      <span class="card__photo-count">{{ 'products.product.photo_count' | t: count: product.media.size }}</span>
    {%- endif -%}
  </a>

  <div class="card__info">
    <div>
      <h3 class="card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
      {%- if product.metafields.custom.tagline != blank -%}
        <p class="card__tagline">{{ product.metafields.custom.tagline.value }}</p>
      {%- endif -%}
    </div>

    {%- if colour_option -%}
      <div class="card__swatches">
        {%- for value in colour_option.values -%}
          <span class="swatch" title="{{ value | escape }}" style="background: {% render 'swatch-color', name: value %};"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <p class="card__sizes">
      {%- if size_option -%}
        {{ size_option.values | join: ' · ' }}
      {%- else -%}
        {{ 'products.product.one_size' | t }}
      {%- endif -%}
    </p>

    <div class="card__footer">
      {% render 'price', product: product %}

      {%- if settings.card_show_quick_add -%}
        <div class="card__quick-add">
          {%- if product.available == false -%}
            <span class="button button--small button--secondary" aria-disabled="true">{{ 'products.product.sold_out' | t }}</span>
          {%- elsif product.has_only_default_variant -%}
            {%- form 'product', product, data-ajax-cart: '' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="button button--small">
                {% render 'icon', name: 'cart' %}
                {{ 'products.product.quick_add' | t }}
              </button>
            {%- endform -%}
          {%- else -%}
            <a href="{{ product.url }}" class="button button--small">
              {% render 'icon', name: 'cart' %}
              {{ 'products.product.choose' | t }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</article>
