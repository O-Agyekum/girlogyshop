{%- comment -%}
  Design tokens, driven by theme settings so colours can be changed in the theme editor.
  Defaults match the girlogy brand palette.
{%- endcomment -%}
<style>
  /* Fonts are self-hosted on the Shopify CDN: no visitor data is sent to Google. */
  @font-face {
    font-family: "Archivo Black";
    src: url("{{ 'archivo-black-latin-400-normal.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Hind";
    src: url("{{ 'hind-latin-400-normal.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Hind";
    src: url("{{ 'hind-latin-500-normal.woff2' | asset_url }}") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Hind";
    src: url("{{ 'hind-latin-600-normal.woff2' | asset_url }}") format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Hind";
    src: url("{{ 'hind-latin-700-normal.woff2' | asset_url }}") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Playfair Display";
    src: url("{{ 'playfair-display-latin-500-italic.woff2' | asset_url }}") format("woff2");
    font-weight: 500;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: "Playfair Display";
    src: url("{{ 'playfair-display-latin-600-italic.woff2' | asset_url }}") format("woff2");
    font-weight: 600;
    font-style: italic;
    font-display: swap;
  }

  :root {
    --color-bg: {{ settings.color_background }};
    --color-surface: {{ settings.color_surface }};
    --color-secondary: {{ settings.color_secondary }};
    --color-text: {{ settings.color_text }};
    --color-text-soft: {{ settings.color_text_soft }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-hover: {{ settings.color_accent | color_lighten: 12 }};
    --color-on-accent: {{ settings.color_on_accent }};
    --color-rust: {{ settings.color_rust }};
    --color-blush: {{ settings.color_blush }};
    --color-gold: {{ settings.color_rust }};
    --color-line: {{ settings.color_border }};
    --color-sale: #a4302a;
    --color-success: #2f6b3f;

    --font-heading: "Archivo Black", system-ui, sans-serif;
    --font-body: "Hind", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
    --font-script: "Playfair Display", Georgia, "Times New Roman", serif;

    --radius: {{ settings.corner_radius }}px;
    --radius-button: {{ settings.button_radius }}px;
    --page-width: {{ settings.page_width }}px;
  }
</style>
