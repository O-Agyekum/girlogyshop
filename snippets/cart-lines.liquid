{%- comment -%}
  Cart line items, shared by the cart drawer and the cart page.
  In the drawer, quantity changes are sent with JavaScript.
  On the cart page they are submitted with the cart form, so the page works without JavaScript.
{%- endcomment -%}
<ul class="cart-items">
  {%- for item in cart.items -%}
    <li class="cart-item">
      <a href="{{ item.url }}" class="cart-item__image" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {%- assign line_alt = item.image.alt | default: item.product.title -%}
          {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: line_alt }}
        {%- endif -%}
      </a>

      <div>
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__options">
            {%- for option in item.options_with_values -%}
              {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
            {%- endfor -%}
          </p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- unless property.last == blank or property.first contains '_' -%}
            <p class="cart-item__options">{{ property.first }}: {{ property.last }}</p>
          {%- endunless -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__options">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}

        <div class="quantity">
          <button type="button" data-qty="minus" aria-label="{{ 'cart.decrease' | t: product: item.product.title | escape }}">&minus;</button>
          <input
            type="number"
            {% if mode == 'page' %}name="updates[]"{% else %}data-line-key="{{ item.key }}"{% endif %}
            value="{{ item.quantity }}"
            min="0"
            aria-label="{{ 'cart.quantity' | t }}"
          >
          <button type="button" data-qty="plus" aria-label="{{ 'cart.increase' | t: product: item.product.title | escape }}">+</button>
        </div>
        {%- if mode == 'page' -%}
          <a href="{{ item.url_to_remove }}" class="cart-item__remove">{{ 'cart.remove' | t }}</a>
        {%- else -%}
          <button type="button" class="cart-item__remove" data-remove-line="{{ item.key }}">{{ 'cart.remove' | t }}</button>
        {%- endif -%}
      </div>

      <div class="price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </li>
  {%- endfor -%}
</ul>
