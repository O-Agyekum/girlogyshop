{%- comment -%}
  Filled in by theme.js: Shopify only computes recommendations when this
  section is requested through the product recommendations URL.
{%- endcomment -%}
<div
  class="product-recommendations"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section">
      <div class="page-width">
        <div class="section-header"><h2>{{ section.settings.heading | escape }}</h2></div>
        <ul class="product-grid product-grid--4">
          {%- for rec in recommendations.products -%}
            <li>{% render 'product-card', product: rec, lazy: true %}</li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Related products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
