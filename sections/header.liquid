{%- assign menu = section.settings.menu -%}

<div class="header-wrapper">
  <header class="header page-width">
    <button type="button" class="icon-button header__menu-toggle" data-open="MobileMenu" aria-controls="MobileMenu" aria-label="{{ 'sections.header.menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        {%- liquid
          assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round
          assign logo_alt = shop.name | escape
        -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            width: section.settings.logo_width,
            height: logo_height,
            alt: logo_alt,
            loading: 'eager',
            style: 'max-width: 100%; height: auto;'
        }}
      {%- else -%}
        <span class="header__logo-text">{% render 'wordmark', text: shop.name %}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="{{ 'sections.header.main_nav' | t }}">
      {%- if menu != blank -%}
        <ul>
          {%- for link in menu.links -%}
            <li>
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- if link.links.size > 0 -%}
                <ul class="header__submenu">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>

    <div class="header__icons">
      <button type="button" class="icon-button" data-open="SearchModal" aria-controls="SearchModal" aria-label="{{ 'general.search.title' | t }}">
        {% render 'icon', name: 'search' %}
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="icon-button" aria-label="{{ 'sections.header.account' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="icon-button"
        {% if settings.cart_type == 'drawer' and template.name != 'cart' %}data-open="CartDrawer" aria-controls="CartDrawer"{% endif %}
        aria-label="{{ 'sections.header.cart' | t }}"
      >
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">
          {%- if cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}
        </span>
      </a>
    </div>
  </header>
</div>

<div class="mobile-menu" id="MobileMenu" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
  <div class="mobile-menu__overlay" data-close></div>
  <div class="mobile-menu__panel" data-panel>
    <button type="button" class="icon-button" data-close aria-label="{{ 'general.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
    {%- if menu != blank -%}
      <ul class="mobile-menu__list">
        {%- for link in menu.links -%}
          <li>
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- if link.links.size > 0 -%}
              <ul>
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<div class="search-modal" id="SearchModal" role="dialog" aria-modal="true" aria-label="{{ 'general.search.title' | t }}">
  <div class="search-modal__panel" data-panel>
    <div class="page-width">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="SearchModalInput">{{ 'general.search.title' | t }}</label>
        <input
          class="input"
          id="SearchModalInput"
          type="search"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
        <button type="button" class="icon-button" data-close aria-label="{{ 'general.close' | t }}">
          {% render 'icon', name: 'close' %}
        </button>
      </form>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Leave empty to show the girlogy wordmark in text" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
