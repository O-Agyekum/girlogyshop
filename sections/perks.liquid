<div class="perks">
  <ul class="page-width">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        {% render 'icon', name: block.settings.icon %}
        {{ block.settings.text | escape }}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Perks strip",
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "lock", "label": "Secure payment" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over €75" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Perks strip",
      "blocks": [
        { "type": "perk", "settings": { "icon": "truck", "text": "Free shipping over €75" } },
        { "type": "perk", "settings": { "icon": "return", "text": "14-day returns" } },
        { "type": "perk", "settings": { "icon": "sparkle", "text": "Limited weekly drops" } }
      ]
    }
  ]
}
{% endschema %}
