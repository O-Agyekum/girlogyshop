<section class="section">
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    <div class="collection-tiles" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.collections_url }}{% endif %}" class="collection-tile" {{ block.shopify_attributes }}>
          {%- assign tile_image = block.settings.image | default: c.featured_image -%}
          {%- if tile_image != blank -%}
            {{ tile_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 50vw', widths: '360, 540, 720, 900', alt: '' }}
          {%- endif -%}
          <span class="collection-tile__label">
            <span>
              {%- if block.settings.title != blank -%}
                {{ block.settings.title | escape }}
              {%- elsif c != blank -%}
                {{ c.title | escape }}
              {%- else -%}
                {{ 'sections.collection_list.placeholder' | t }}
              {%- endif -%}
            </span>
            <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your fit" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Custom title" },
        { "type": "image_picker", "id": "image", "label": "Custom image" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection", "settings": { "title": "Tops" } },
        { "type": "collection", "settings": { "title": "Sets" } },
        { "type": "collection", "settings": { "title": "Bags" } },
        { "type": "collection", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
