<section class="section">
  <div class="page-width">
    <div class="newsletter">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="text-soft">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- assign form_id = 'Newsletter-' | append: section.id -%}
      {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" style="flex-basis:100%;">{{ 'sections.newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-message form-message--error" style="flex-basis:100%;">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
        {%- endif -%}
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'sections.newsletter.label' | t }}</label>
        <input
          class="input"
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          autocomplete="email"
          required
          placeholder="{{ 'sections.newsletter.label' | t }}"
        >
        <button type="submit" class="button">{{ 'sections.newsletter.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Weekly drops" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the study group" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New captions and first access to every drop. No spam, just overthinking.</p>" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
