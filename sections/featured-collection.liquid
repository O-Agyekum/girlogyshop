{%- assign collection = section.settings.collection -%}

<section class="section">
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="link-arrow">{{ 'sections.featured_collection.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <ul class="product-grid{% if section.settings.columns == '4' %} product-grid--4{% endif %}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li>{% render 'product-card', product: product, lazy: true %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <li>
            <article class="card">
              <div class="card__media"><span class="card__placeholder">{% render 'icon', name: 'girl' %}</span></div>
              <div class="card__info">
                <h3 class="card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3>
                <p class="card__sizes">XS · S · M · L · XL</p>
                <div class="card__footer"><div class="price">{{ 3200 | money }}</div></div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Just dropped" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop all" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
