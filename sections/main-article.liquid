<article class="section">
  <div class="page-width main-page">
    <p class="article-meta" style="text-align:center;">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1>{{ article.title | escape }}</h1>
    {%- if article.image -%}
      <div class="article-card__media" style="margin-bottom:32px;">
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 780px) 780px, 100vw', widths: '600, 900, 1200, 1600', alt: article.image.alt }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p style="margin-top:40px;"><a href="{{ blog.url }}" class="link-arrow">&larr; {{ 'blogs.back' | t: title: blog.title }}</a></p>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "settings": []
}
{% endschema %}
