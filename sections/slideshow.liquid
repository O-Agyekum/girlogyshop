<section class="hero" data-slideshow data-autoplay="{{ section.settings.autoplay_speed }}" aria-roledescription="carousel" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div class="hero__slides">
    {%- for block in section.blocks -%}
      <div
        class="hero__slide{% if forloop.first %} is-active{% endif %}{% if block.settings.image != blank %} hero__slide--has-image{% endif %}"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} / {{ forloop.length }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          <div class="hero__media">
            {%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- else -%}{%- assign loading = 'lazy' -%}{%- endif -%}
            {%- assign slide_alt = block.settings.image.alt | default: block.settings.heading -%}
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: loading,
                sizes: '100vw',
                widths: '750, 1100, 1500, 1920, 2400',
                alt: slide_alt
            }}
          </div>
        {%- else -%}
          <div class="hero__placeholder">{% render 'icon', name: 'girl' %}</div>
        {%- endif -%}

        <div class="page-width" style="position:relative;width:100%;">
          <div class="hero__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              {%- if forloop.first -%}<h1 class="hero__title">{%- else -%}<h2 class="hero__title">{%- endif -%}
                {{ block.settings.heading | escape }}
                {%- if block.settings.script_line != blank -%}
                  <span class="script">{{ block.settings.script_line | escape }}</span>
                {%- endif -%}
              {%- if forloop.first -%}</h1>{%- else -%}</h2>{%- endif -%}
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="hero__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="hero__buttons">
                <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button">{{ block.settings.button_label | escape }}</a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'sections.slideshow.go_to' | t: index: forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Slideshow",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "autoplay_speed", "label": "Change slides every", "min": 0, "max": 10, "step": 1, "unit": "s", "default": 6, "info": "0 turns autoplay off" },
    { "type": "text", "id": "accessibility_label", "label": "Slideshow description", "default": "Featured drops" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "New drop" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Wear the overthinking." },
        { "type": "text", "id": "script_line", "label": "Script line", "default": "the study of being a girl" },
        { "type": "text", "id": "text", "label": "Text", "default": "Caption tees, soft sets and the little extras." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide", "settings": { "heading": "Low social battery.", "script_line": "high iced coffee intake", "eyebrow": "Drop 02" } }]
    }
  ]
}
{% endschema %}
