{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign size_option = null
  for option in product.options_with_values
    assign option_key = option.name | downcase
    if option_key == 'size' or option_key == 'taille'
      assign size_option = option
    endif
  endfor
-%}

<section class="section" style="padding-top: 32px;">
  <div
    class="page-width product"
    data-product
    data-update-url
    data-money-format="{{ shop.money_format | strip_html | escape }}"
  >
    <script type="application/json" data-product-json>{{ product | json }}</script>

    <div class="product__media">
      {%- if product.media.size > 0 -%}
        <ul class="product__media-list">
          {%- for media in product.media -%}
            <li class="product__media-item" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- else -%}{%- assign loading = 'lazy' -%}{%- endif -%}
                  {%- assign media_alt = media.alt | default: product.title -%}
                  {{
                    media
                    | image_url: width: 1600
                    | image_tag:
                      loading: loading,
                      sizes: '(min-width: 990px) 55vw, 90vw',
                      widths: '600, 900, 1200, 1600',
                      alt: media_alt
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, preload: 'metadata', playsinline: true }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="product__media-item card__media"><span class="card__placeholder">{% render 'icon', name: 'girl' %}</span></div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- assign badge = '' -%}
      {%- for tag in product.tags -%}
        {%- if tag contains 'badge:' -%}
          {%- assign badge = tag | remove_first: 'badge:' | strip -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if badge != '' -%}
        <span class="badge" style="display:inline-block;margin-bottom:14px;">{{ badge }}</span>
      {%- endif -%}

      <h1 class="product__title">{{ product.title | escape }}</h1>
      {%- if product.metafields.custom.tagline != blank -%}
        <p class="product__tagline">{{ product.metafields.custom.tagline.value }}</p>
      {%- endif -%}

      {% render 'price', product: product, variant: current_variant, class: 'price--large' %}
      <p class="product__tax">
        {%- if cart.taxes_included -%}
          {{ 'products.product.taxes_included' | t }}
        {%- else -%}
          {{ 'products.product.taxes_excluded' | t }}
        {%- endif -%}
        {%- if shop.shipping_policy.body != blank %}
          · <a href="{{ shop.shipping_policy.url }}">{{ 'products.product.shipping_link' | t }}</a>
        {%- endif -%}
      </p>

      <div class="product__form">
        {%- form 'product', product, data-ajax-cart: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_key = option.name | downcase -%}
              {%- assign is_colour = false -%}
              {%- if option_key == 'color' or option_key == 'colour' or option_key == 'couleur' -%}
                {%- assign is_colour = true -%}
              {%- endif -%}
              <fieldset class="option-group" data-option-index="{{ forloop.index0 }}">
                <legend>{{ option.name | escape }}: <span class="text-soft">{{ option.selected_value | escape }}</span></legend>
                <div class="option-pills">
                  {%- for value in option.values -%}
                    {%- assign input_id = 'Option-' | append: section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                    <input
                      type="radio"
                      id="{{ input_id }}"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    <label for="{{ input_id }}">
                      {%- if is_colour -%}
                        <span class="swatch" style="background: {% render 'swatch-color', name: value %};vertical-align:-3px;margin-right:6px;"></span>
                      {%- endif -%}
                      {{ value | escape }}
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'cart.quantity' | t }}</label>
          <div class="product__buy">
            <div class="quantity">
              <button type="button" data-qty="minus" aria-label="{{ 'cart.decrease' | t: product: product.title | escape }}">&minus;</button>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
              <button type="button" data-qty="plus" aria-label="{{ 'cart.increase' | t: product: product.title | escape }}">+</button>
            </div>
            <button type="submit" class="button" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>

          {%- if section.settings.show_dynamic_checkout -%}
            <div class="product__payment">{{ form | payment_button }}</div>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="product__description">
        {%- if product.description != blank -%}
          <div class="rte">{{ product.description }}</div>
        {%- endif -%}

        {%- if product.metafields.custom.details != blank -%}
          <details class="accordion" open>
            <summary>{{ 'products.product.details' | t }}</summary>
            <div class="accordion__content">
              <ul class="product__details">
                {%- for line in product.metafields.custom.details.value -%}
                  <li>{{ line }}</li>
                {%- endfor -%}
              </ul>
            </div>
          </details>
        {%- endif -%}

        {%- if section.settings.show_size_guide and size_option -%}
          <details class="accordion">
            <summary>{{ 'products.product.size_guide' | t }}</summary>
            <div class="accordion__content">
              {% render 'size-guide', first_size: size_option.values.first %}
            </div>
          </details>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'collapsible' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}</summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product page",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout buttons", "default": true },
    { "type": "checkbox", "id": "show_size_guide", "label": "Show size guide", "default": true, "info": "Shown when the product has a Size option" }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping and returns" },
        { "type": "richtext", "id": "content", "label": "Text" },
        { "type": "page", "id": "page", "label": "Or show a page" }
      ]
    }
  ]
}
{% endschema %}
