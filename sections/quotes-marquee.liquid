{%- if section.blocks.size > 0 -%}
  <div class="quotes" role="region" aria-label="{{ section.settings.label | escape }}">
    <div class="quotes__track">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <p class="quotes__item" {{ block.shopify_attributes }}{% if i > 1 %} aria-hidden="true"{% endif %}>{{ block.settings.quote | escape }}</p>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Quote marquee",
  "settings": [
    { "type": "text", "id": "label", "label": "Description for screen readers", "default": "girlogy captions" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Caption",
      "settings": [
        { "type": "text", "id": "quote", "label": "Caption", "default": "Operating strictly on caffeine and peaceful denial." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Quote marquee",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Operating strictly on caffeine and peaceful denial." } },
        { "type": "quote", "settings": { "quote": "Weekend mode: activated. Adulting: paused." } },
        { "type": "quote", "settings": { "quote": "I'm not doing too much. You're just witnessing enough." } },
        { "type": "quote", "settings": { "quote": "Be picky. Everything you want exists." } }
      ]
    }
  ]
}
{% endschema %}
