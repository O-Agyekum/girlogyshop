{%- comment -%}
  Collection page in the girlogy shop style: banner, chip filters, sort and a product grid.
  Filters come from Shopify's Search & Discovery app (Online Store > Navigation > Filters),
  so they keep working when products are added in the admin.
{%- endcomment -%}

<div class="collection-hero">
  <div class="page-width">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-hero__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

<section class="page-width" style="padding-bottom: 64px;">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if section.settings.enable_filters and collection.filters.size > 0 -%}
      <div class="collection-filters">
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'list' and filter.values.size > 0 -%}
            {%- assign filter_key = filter.label | downcase -%}
            {%- assign is_colour = false -%}
            {%- if filter_key contains 'colo' or filter_key contains 'couleur' -%}
              {%- assign is_colour = true -%}
            {%- endif -%}
            <div class="chip-row" role="group" aria-label="{{ filter.label | escape }}">
              <span class="chip-row__label">{{ filter.label | escape }}</span>
              {%- for value in filter.values -%}
                {%- if value.count > 0 or value.active -%}
                  <a
                    href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                    class="chip{% if value.active %} is-active{% endif %}"
                    {% if value.active %}aria-current="true"{% endif %}
                  >
                    {%- if is_colour -%}
                      <span class="swatch" style="background: {% render 'swatch-color', name: value.label %};"></span>
                    {%- endif -%}
                    {{ value.label | escape }}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="collection-toolbar">
      <div class="filters">
        <span>{{ 'collections.product_count' | t: count: collection.products_count }}</span>
        {%- liquid
          assign active_count = 0
          for filter in collection.filters
            assign active_count = active_count | plus: filter.active_values.size
          endfor
        -%}
        {%- if active_count > 0 -%}
          <a href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}" class="link-arrow">{{ 'collections.clear_filters' | t }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.enable_sorting -%}
        <label class="filters">
          <span>{{ 'collections.sort_by' | t }}</span>
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <select class="select" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
        </label>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid{% if section.settings.columns == '4' %} product-grid--4{% endif %}">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product, lazy: true %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="cart-empty text-soft">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above title", "default": "the study of being a girl" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "checkbox", "id": "enable_filters", "label": "Show filters", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Show sorting", "default": true }
  ]
}
{% endschema %}
