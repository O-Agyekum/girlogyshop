<section class="section">
  <div class="page-width">
    <div class="section-header section-header--center">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
    </div>
    <div class="collection-tiles" style="--cols: 3;">
      {%- for c in collections -%}
        {%- unless c.handle == 'frontpage' -%}
          <a href="{{ c.url }}" class="collection-tile">
            {%- if c.featured_image -%}
              {{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 50vw', widths: '360, 540, 720, 900', alt: '' }}
            {%- endif -%}
            <span class="collection-tile__label"><span>{{ c.title | escape }}</span><span aria-hidden="true">&rarr;</span></span>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
