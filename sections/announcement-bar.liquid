{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
-%}
{%- if messages.size > 0 -%}
  <div class="announcement{% if section.settings.scrolling == false %} announcement--static{% endif %}" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    <div class="announcement__track">
      {%- comment -%} Messages are repeated so the scrolling loop has no gap. {%- endcomment -%}
      {%- assign loops = 1 -%}
      {%- if section.settings.scrolling -%}{%- assign loops = 4 -%}{%- endif -%}
      {%- for i in (1..loops) -%}
        {%- for block in messages -%}
          <p class="announcement__item" {{ block.shopify_attributes }}{% if i > 1 %} aria-hidden="true"{% endif %}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "checkbox", "id": "scrolling", "label": "Scroll messages", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over €75" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "enabled_on": { "groups": ["header"] },
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping over €75" } },
        { "type": "message", "settings": { "text": "Limited weekly drops" } },
        { "type": "message", "settings": { "text": "The study of being a girl" } }
      ]
    }
  ]
}
{% endschema %}
