<section class="password-page">
  <div>
    {% render 'wordmark', text: shop.name %}
    <h1 style="margin-top:24px;">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="text-soft">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__form">
          <label class="visually-hidden" for="PasswordNewsletter">{{ 'sections.newsletter.label' | t }}</label>
          <input class="input" id="PasswordNewsletter" type="email" name="contact[email]" required placeholder="{{ 'sections.newsletter.label' | t }}">
          <button type="submit" class="button">{{ 'sections.newsletter.submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details style="margin-top:40px;">
      <summary class="text-soft" style="cursor:pointer;">{{ 'general.password.owner' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="newsletter__form">
          <label class="visually-hidden" for="StorePassword">{{ 'general.password.label' | t }}</label>
          <input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password.label' | t }}">
          <button type="submit" class="button button--secondary">{{ 'general.password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." }
  ]
}
{% endschema %}
