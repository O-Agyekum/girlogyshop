<section class="split-hero" id="SplitHero-{{ section.id }}">
  <div class="page-width split-hero__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="split-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="hero__buttons">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: routes.root_url }}" class="button button--light">{{ section.settings.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="split-hero__media">
      {%- if section.settings.image != blank -%}
        {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '600, 900, 1200, 1600',
            alt: hero_alt
        }}
      {%- else -%}
        {% render 'icon', name: 'girl' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Drop 01 · the study of being a girl" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear the overthinking." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Slit dresses, oversized tops, wide-leg denim, tracksuits, laptop bags and the little extras. Every piece shot from three angles.</p>" },
    { "type": "text", "id": "button_label", "label": "First button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "First button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "See the feed" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Split banner" }]
}
{% endschema %}
