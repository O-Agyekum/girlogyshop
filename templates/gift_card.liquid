{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} &ndash; {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="password-page">
      <div>
        {% render 'wordmark', text: shop.name %}
        <h1 style="margin-top:24px;">{{ gift_card.initial_value | money }}</h1>
        {%- assign balance = gift_card.balance | money -%}
        <p class="text-soft">{{ 'gift_card.balance' | t: balance: balance }}</p>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="form-message form-message--error">{{ 'gift_card.expired' | t }}</p>
        {%- endif -%}
        <p>{{ 'gift_card.code_label' | t }}</p>
        <p style="font-size:1.4rem;letter-spacing:.12em;font-weight:600;">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display:flex;justify-content:center;margin:20px 0;"></div>
        <p><a href="{{ shop.url }}" class="button">{{ 'gift_card.shop_link' | t }}</a></p>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
